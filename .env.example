# Optional local Ollama enrichment
OLLAMA_URL=http://127.0.0.1:11434/api/generate
HEXSTRIKE_OLLAMA_MODEL=gemma3:4b
# Optional web content discovery wordlist
HEXSTRIKE_WEB_WORDLIST=/path/to/wordlist.txt
# Optional ScanX executable path; exact arguments depend on installed ScanX build
SCANX_BIN=scanx
